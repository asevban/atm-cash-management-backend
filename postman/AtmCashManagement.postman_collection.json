                  "const atm = body.atms.find(a => a.atmId === pm.environment.get('atmId'));",
                  "pm.test('Network totals reconcile and include the approved cash adjustment', function () {",
                  "  pm.expect(atm).to.exist;",
                  "  pm.expect(atm.state).to.eql('IN_SERVICE');",
                  "  pm.expect(atm.physicalValueTry).to.eql(9900);",
                  "  pm.expect(body.networkPhysicalValueTry).to.be.at.least(atm.physicalValueTry);",
                  "  const summed = body.networkTotalsByCurrency.reduce((sum, total) => sum + Number(total.physicalValueTry), 0);",
                  "  pm.expect(summed).to.be.closeTo(body.networkPhysicalValueTry, 0.001);",
                  "});"
